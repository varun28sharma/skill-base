# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# PostgreSQL connection string (Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret — use a long random string
JWT_SECRET=change_me_to_a_long_random_secret

# Server port (Firebase / Cloud Run sets this automatically)
PORT=3001

# Environment
NODE_ENV=development

# Comma-separated list of allowed origins in production (optional)
# ALLOWED_ORIGINS=https://your-project.web.app,https://your-domain.com
