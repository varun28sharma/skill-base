{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/_/backend/**",
        "destination": "/_/backend/**"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "experimentalServices": {
      "frontend": {
        "routePrefix": "/",
        "framework": "vite"
      },
      "backend": {
        "root": "backend",
        "routePrefix": "/_/backend"
      }
    }
  }
}
