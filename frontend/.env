# Frontend environment variables
# Direct URL to the backend API
VITE_API_URL=http://localhost:3001

# Google OAuth Client ID — REQUIRED for "Continue with Google" to work
# Get yours from: https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Set "Authorized JavaScript origins" to: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=207854203446-frsolchpdnpn1h2g75uhmb264grrbshc.apps.googleusercontent.com

# Optional: Firebase credentials (alternative to Google Client ID above)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
